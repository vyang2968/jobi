{
  "name": "jobi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite dev",
    "build": "bun run db:generate && vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "vite dev",
    "cf-typegen": "wrangler types",
    "db:generate": "cd packages/db && prisma generate",
    "db:migrate:create": "cd packages/db && prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:migrate:apply:local": "cd packages/db && wrangler d1 execute jobi-db --local --file=prisma/migrations/migration.sql"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@jobi/db": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "chanfana": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "hono": "^4.12.12",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}