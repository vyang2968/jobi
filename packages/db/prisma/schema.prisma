generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model Task {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  completed   Boolean  @default(false)
  due_date    String?
}